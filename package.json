{
  "name": "u1webcore",
  "version": "0.2.4",
  "description": "Astro SEO integration: meta tags, Open Graph images, JSON-LD schema, sitemaps, robots.txt, llms.txt (AEO/GEO for AI search), redirects, consent banner and an SEO audit CLI.",
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "seo",
    "astro-seo",
    "meta-tags",
    "open-graph",
    "og-image",
    "json-ld",
    "schema-org",
    "structured-data",
    "sitemap",
    "robots-txt",
    "llms-txt",
    "aeo",
    "geo",
    "ai-search",
    "generative-engine-optimization",
    "redirects",
    "cookie-consent",
    "gdpr",
    "seo-audit",
    "rss"
  ],
  "homepage": "https://github.com/Peburu01/u1webcore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peburu01/u1webcore.git"
  },
  "bugs": {
    "url": "https://github.com/Peburu01/u1webcore/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./astro": {
      "types": "./src/astro/integration.ts",
      "default": "./dist/astro/integration.mjs"
    },
    "./astro/integration.mjs": "./dist/astro/integration.mjs",
    "./astro/middleware.mjs": "./dist/astro/middleware.mjs",
    "./astro/*": "./dist/astro/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "bun test",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "astro": ">=7"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "rolldown": "1.2.18",
    "satori": "^0.63.2",
    "typescript": "^7.0.2"
  },
  "bin": {
    "u1webcore": "dist/cli.mjs"
  }
}
