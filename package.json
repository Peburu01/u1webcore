{
  "name": "u1webcore",
  "version": "0.1.0",
  "description": "SEO, AEO/GEO, meta, Open Graph, JSON-LD, robots/sitemaps/llms.txt, redirects, tags and consent for websites. Pure core + Astro integration.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./astro": {
      "types": "./src/astro/integration.ts",
      "default": "./dist/astro/integration.mjs"
    },
    "./astro/integration.mjs": "./dist/astro/integration.mjs",
    "./astro/middleware.mjs": "./dist/astro/middleware.mjs",
    "./astro/*": "./dist/astro/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "bun test",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "astro": ">=7"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "rolldown": "1.2.18",
    "satori": "^0.63.2",
    "typescript": "^7.0.2"
  },
  "bin": {
    "u1webcore": "dist/cli.mjs"
  }
}
